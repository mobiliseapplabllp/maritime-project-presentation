PORT=5200
MONGO_URI=mongodb://127.0.0.1:27017/mundra_portal
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# Signs every certificate the registry issues. Must be set, and must differ from
# JWT_SECRET: the JWT secrets are meant to be rotated, and this one must never
# be, because rotating it invalidates every signature already issued. Leaving it
# unset makes the code fall back to JWT_SECRET, which quietly ties the two
# together. See DEPLOYMENT.md, "The certificate signing key".
CERT_SIGNING_SECRET=change_me_certificate_signing_key_and_never_rotate_it
