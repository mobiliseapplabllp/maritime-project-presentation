# Production environment — copy to .env.prod and fill in.
# Generate secrets with: openssl rand -hex 48   (rotate on every secrets change)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Signs every certificate the registry issues. Generate it ONCE and never change
# it: verification recomputes the signature from the register entry, so a new key
# makes every certificate already issued verify as "signed by a key this registry
# no longer holds". Rotate the JWT secrets freely; leave this one alone.
CERT_SIGNING_SECRET=
# Same-origin by default; set only if the UI is served from a different host
CORS_ORIGIN=
# Optional: enables the live AI assistant
ANTHROPIC_API_KEY=
